[Variables]
; --- Prism: Cyberpunk Dark ---
; Near-black background, sharp corners. Neon cyan time.
; Magenta date text. JetBrains Mono for the terminal/tech vibe.
; No border or accent bar.

; Background
bgType=1
bgColor=10,5,20,220
bgCornerRadius=4
bgBlur=0
bgBorderColor=0,0,0,0
bgBorderThickness=0
bgPadding=12
bgShadow=0
bgWidth=236
bgHeight=110

; Accent
accentColor=255,0,200,180
accentHeight=0

; Typography
fontTime=JetBrains Mono
fontDate=JetBrains Mono
fontSize_Time=42
fontSize_Date=11
fontSize_AmPm=13
fontStyle_Time=Bold
fontStyle_Date=Normal

; Colors
colorTime=0,255,255,255
colorDate=255,0,200,200
colorAmPm=0,255,255,180
colorShadow=0,0,0,0
textShadowEffect=None
glowColor=0,255,255,100
; StringEffect value: None, Shadow or Border (Rainmeter has no Glow effect).
glowEffect=None

; Progress Bar
barFillColor=0,255,255,220
barTrackColor=255,255,255,15
barHeight=6
barCornerRadius=2
barLabelFont=JetBrains Mono
barLabelSize=10
barLabelColor=0,255,255,200
barValueColor=255,0,200,180
barValueSize=10
; StringEffect value: None, Shadow or Border (Rainmeter has no Glow effect).
barGlowEffect=None
barGlowColor=0,255,255,80
barClaudeColor=217,119,87,255
barChatGPTColor=16,163,127,255
barGeminiColor=66,133,244,255
; Stale data (no recent update): dimmed bar fill, and the color of the
; "updated N ago" / "cached" note
barStaleFillColor=0,255,255,88
barStaleColor=255,214,0,220
barWidgetWidth=236
barWidgetHeightCompact=66
barWidgetHeightExpanded=103
barWidgetHeightConsumer=148
