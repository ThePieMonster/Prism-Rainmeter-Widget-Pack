{
  "manifest_version": 3,
  "name": "Prism Usage Tracker",
  "version": "1.0.0",
  "description": "Fetches AI service usage data and sends it to the Prism Rainmeter widget pack.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://platform.claude.com/*",
    "https://platform.openai.com/*",
    "https://api.openai.com/*",
    "https://aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://platform.openai.com/*"],
      "js": ["openai-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["aistudio-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Prism Usage Tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
